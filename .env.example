# PathFinder Configuration Example

# Project Settings
PROJECT_NAME="PathFinder — AI-Powered Personalized Learning Path Recommender"
VERSION="1.0.0"

# Database Configuration (SQLite by default, PostgreSQL supported)
DATABASE_URL="sqlite:///./pathfinder.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/pathfinder"

# AI / LLM Configuration
# Optional: Provide your Google Gemini API key to enable live Gemini-1.5 models.
# If left blank, PathFinder automatically activates its intelligent built-in fallback provider with 100% feature parity.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
USE_MOCK_AI="false"

# Server Port Settings
PORT=8000
VITE_PORT=5173
